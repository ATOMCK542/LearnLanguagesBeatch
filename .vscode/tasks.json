{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build APK",
      "type": "shell",
      "command": "./gradlew assembleDebug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "${workspaceFolder}/.tools/jdk-17",
          "ANDROID_HOME": "${workspaceFolder}/.tools/android-sdk",
          "ANDROID_SDK_ROOT": "${workspaceFolder}/.tools/android-sdk"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Install APK",
      "type": "shell",
      "command": "./gradlew installDebug",
      "group": "none",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "${workspaceFolder}/.tools/jdk-17",
          "ANDROID_HOME": "${workspaceFolder}/.tools/android-sdk",
          "ANDROID_SDK_ROOT": "${workspaceFolder}/.tools/android-sdk"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "./gradlew check",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "${workspaceFolder}/.tools/jdk-17",
          "ANDROID_HOME": "${workspaceFolder}/.tools/android-sdk",
          "ANDROID_SDK_ROOT": "${workspaceFolder}/.tools/android-sdk"
        }
      },
      "problemMatcher": []
    }
  ]
}
